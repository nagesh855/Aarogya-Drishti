# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string for MERN persistence.
# When omitted in development, Aarogya Drishti uses persistent local JSON storage.
MONGODB_URI=""

# JWT_SECRET: Secret used to sign role-based session tokens on the server.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# Optional Aadhaar fields are encrypted with AES-256-GCM. Set this to a unique
# 32-byte key encoded as base64 (for example: openssl rand -base64 32).
AADHAAR_ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_BYTE_BASE64_KEY"

# Optional Real-Time SMS Providers for Patient OTP (Twilio or MSG91).
# When omitted, real-time SSE + Gemini AI Voice OTP delivery remains active.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
